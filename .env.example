# Copy to .env and fill in. Variables already set in your shell take precedence.

# Contact email sent with NCBI requests; NCBI asks every client to identify itself.
PUBMED_EMAIL=you@example.org

# Optional: raises the NCBI rate limit from 3 to 10 requests/s.
# https://www.ncbi.nlm.nih.gov/account/settings/
# NCBI_API_KEY=

# Required only for [llm] provider = "anthropic" (and `uv sync --extra anthropic`).
# ANTHROPIC_API_KEY=

# Optional overrides.
# OLLAMA_BASE_URL=http://localhost:11434
# PAPERPULSE_DB=paperpulse.db

# Set to 1 once the embedding model is downloaded to skip Hugging Face update checks.
# HF_HUB_OFFLINE=1
